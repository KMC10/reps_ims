<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - REPS Incident Management System</title>

    <link rel="stylesheet" href="~/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/bootstrap/css/SiteCSS.css" />
    <link rel="stylesheet" href="~/bootstrap/css/datepicker.css" />

    <style>
        .reps-system-header {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 24px;
            background: #14283f;
            color: #fff;
            border-bottom: 4px solid #c6a15b;
            border-radius: 5px 5px 0 0;
        }

        .reps-system-logo {
            flex: 0 0 66px;
            width: 66px;
            height: 66px;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #fff;
            border: 2px solid #c6a15b;
            border-radius: 50%;
        }

        .reps-system-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 50%;
        }

        .reps-system-title {
            flex: 1;
            min-width: 0;
        }

        .reps-system-title h1 {
            margin: 0;
            color: #fff;
            font-size: 22px;
            font-weight: 700;
        }

        .reps-system-title p {
            margin: 6px 0 0;
            color: #d1dbe7;
            font-size: 12px;
        }

        .reps-user {
            color: #dfc58e;
            font-size: 12px;
            text-align: right;
        }

        .reps-content {
            padding-top: 20px;
        }

        @@media (max-width: 600px) {
            .reps-system-header {
                gap: 12px;
                padding: 14px;
                flex-wrap: wrap;
            }

            .reps-system-logo {
                flex-basis: 54px;
                width: 54px;
                height: 54px;
            }

            .reps-system-title h1 {
                font-size: 17px;
            }

            .reps-system-title p {
                font-size: 11px;
            }

            .reps-user {
                width: 100%;
                text-align: left;
            }
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="container">

            <header class="reps-system-header">
                <div class="reps-system-logo">
                    <img src="~/images/reps_logo.jpg"
                         alt="Royal Eswatini Police Service logo" />
                </div>

                <div class="reps-system-title">
                    <h1>Incident Management System</h1>
                    <p>Royal Eswatini Police Service</p>
                </div>

                <div class="reps-user">
                    <span class="glyphicon glyphicon-user"></span>
                    <span>@(User.Identity?.Name ?? "User")</span>
                </div>
            </header>

            <nav class="navbar navbar-inverse">
                <div class="container-fluid">
                    <div class="navbar-header">
                        <button type="button"
                                class="navbar-toggle collapsed"
                                data-toggle="collapse"
                                data-target="#myNavbar"
                                aria-expanded="false">
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </button>
                    </div>

                    <div class="collapse navbar-collapse" id="myNavbar">
                        <ul class="nav navbar-nav navbar-right">
                            <li><a asp-page="/Forms/Dashboard">Home</a></li>
                            <li><a href="/Forms/AddIncident?returnUrl=%2FForms%2FDashboard">Add Incident</a></li>
                            <li><a asp-page="/Forms/ViewIncident">View Incident</a></li>
                            <li><a href="/Forms/IncidentMap">Incident Map</a></li>
                            <li><a href="/Forms/CrimeDashboard">Crime Dashboard</a></li>
                            <li><a href="/Forms/IncidentReport">Incident Report</a></li>
                            <li><a asp-page="/Logout">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <main class="reps-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/bootstrap/js/jquery.min.js"></script>
    <script src="~/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/bootstrap/js/bootstrap-datepicker.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>