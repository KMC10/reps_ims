    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="//bootstrap/css/bootstrap.css?v0.7" />
    <link rel="stylesheet" href="//bootstrap/css/SiteCSS.css?v0.2" />
    <link rel="stylesheet" href="//bootstrap/css/datepicker.css?v0.1" />

