
@page "/Forms/IncidentDetails"
@model REPS_IMS.Pages.Forms.IncidentDetailsModel

@{
    Layout = null;
    ViewData["Title"] = "Incident Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Incident Details</title>

    <link rel="stylesheet" href="/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="/bootstrap/css/SiteCSS.css" />

    <style>
        body {
            background: #f3f5f8;
            color: #263238;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
        }

        .document-container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 15px;
        }

        .incident-document {
            background: #fff;
            border: 1px solid #dce2e8;
            border-radius: 5px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .document-header {
            text-align: center;
            padding-bottom: 18px;
            margin-bottom: 24px;
            border-bottom: 3px solid #263b55;
        }

        .document-header h1 {
            margin: 0 0 8px;
            color: #263b55;
            font-size: 23px;
            font-weight: 700;
            letter-spacing: 0.6px;
        }

        .document-header h2 {
            margin: 0 0 10px;
            color: #455a70;
            font-size: 17px;
            font-weight: 600;
        }

        .document-header p {
            margin: 4px 0;
            color: #606b76;
            font-size: 11px;
        }

        .section-title {
            margin: 25px 0 0;
            padding: 10px 12px;
            background: #263b55;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-radius: 3px 3px 0 0;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .incident-table {
            width: 100%;
            margin: 0 0 18px;
            border-collapse: collapse;
            table-layout: fixed;
            background: #fff;
        }

        .incident-table th,
        .incident-table td {
            padding: 9px 10px;
            border: 1px solid #d8dee6 !important;
            text-align: left;
            vertical-align: top;
            overflow-wrap: anywhere;
            word-break: normal;
        }

        .incident-table th {
            width: 19%;
            background: #edf1f5 !important;
            color: #263b55;
            font-weight: 600;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .incident-table td {
            width: 31%;
            color: #303840;
            line-height: 1.5;
        }

        .incident-table ul {
            margin: 0;
            padding-left: 18px;
        }

        .incident-table li {
            margin-bottom: 3px;
        }

        .notes-table th {
            background: #edf1f5 !important;
            color: #263b55;
        }

        .notes-table td {
            white-space: pre-wrap;
        }

        .document-footer {
            margin-top: 25px;
            padding-top: 10px;
            border-top: 1px solid #d8dee6;
            color: #687581;
            font-size: 10px;
            text-align: center;
        }

        .document-actions {
            margin: 0 0 15px;
            text-align: right;
        }

        .status-label {
            display: inline-block;
            padding: 4px 9px;
            border-radius: 3px;
            font-weight: 600;
            border: 1px solid #ccd5df;
        }

        .status-open {
            color: #8a5a00;
            background: #fff4d6;
        }

        .status-closed {
            color: #216e45;
            background: #e4f4ea;
        }

        .empty-message {
            padding: 12px;
            color: #596673;
            background: #f6f8fa;
            border: 1px solid #d8dee6;
        }

        @@media print {
            @@page {
                size: A4 portrait;
                margin: 12mm;
            }

            html,
            body {
                width: 100%;
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                color: #222 !important;
                font-size: 10px;
            }

            .document-container {
                max-width: none;
                margin: 0;
                padding: 0;
            }

            .incident-document {
                margin: 0;
                padding: 0;
                border: none;
                border-radius: 0;
                box-shadow: none;
            }

            .no-print,
            form,
            button,
            .alert {
                display: none !important;
            }

            .document-header {
                margin-bottom: 15px;
                padding-bottom: 10px;
                break-after: avoid;
                page-break-after: avoid;
            }

            .document-header h1 {
                font-size: 18px;
            }

            .document-header h2 {
                font-size: 14px;
            }

            .section-title {
                margin-top: 16px;
                padding: 7px 8px;
                font-size: 10px;
                break-after: avoid;
                page-break-after: avoid;
            }

            .incident-table {
                width: 100%;
                margin-bottom: 12px;
                font-size: 9px;
            }

            .incident-table th,
            .incident-table td {
                padding: 6px;
                overflow-wrap: anywhere;
            }

            .incident-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .document-footer {
                margin-top: 16px;
                font-size: 9px;
            }

            .status-label {
                border: 1px solid #bbb;
            }

                .print-logo {
                    display: block;
                    width: 10px;
                    max-height: 10px;
                    height: auto;
                    object-fit: contain;
                    margin: 0 auto 6px;
                }
        }
    </style>
</head>

<body>
    <div class="document-container">

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger no-print">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.Incident == null)
        {
            <div class="incident-document">
                <p class="empty-message">
                    No incident information found.
                </p>
            </div>
        }
        else
        {
            var incident = Model.Incident;

            <div class="document-actions no-print">
                @if (Model.ShowResolveButton)
                {
                    <form method="post"
                          asp-page-handler="MarkAsResolved"
                          style="display:inline;">
                        <input type="hidden"
                               name="iid"
                               value="@incident.IncidentID" />

                        <button type="submit"
                                class="btn btn-success btn-sm"
                                onclick="return confirm('Are you sure you want to mark this incident as resolved?');">
                            Mark As Resolved
                        </button>
                    </form>
                }

                <button type="button"
                        class="btn btn-default btn-sm"
                        onclick="window.print()">
                    <span class="glyphicon glyphicon-print"></span>
                    Print / Save as PDF
                </button>
            </div>

            <main class="incident-document">

                <header class="document-header">
                    <img src="/images/reps_logo.jpg"
                         alt="Royal Eswatini Police Service logo"
                         style="width: 50px !important; height: 50px !important; object-fit: contain;" />
                    <h1>ROYAL ESWATINI POLICE SERVICE</h1>
                    <h2>INCIDENT DETAILS REPORT</h2>

                    <p>
                        Incident Number:
                        <strong>@incident.IncidentNo</strong>
                    </p>

                    <p>
                        Date Received:
                        <strong>@incident.CallDispatchTime</strong>
                    </p>

                    <p>
                        Document Generated:
                        <strong>@DateTime.Now.ToString("dd MMMM yyyy, HH:mm")</strong>
                    </p>
                </header>

                <section>
                    <h3 class="section-title">Call Attendant Information</h3>

                    <table class="incident-table">
                        <tbody>
                            <tr>
                                <th>Caller Cell / Phone</th>
                                <td>@incident.CallerPhone</td>
                                <th>Caller Name</th>
                                <td>@incident.CallerName</td>
                            </tr>
                            <tr>
                                <th>Caller PIN</th>
                                <td>@incident.CallerPIN</td>
                                <th>Caller Address</th>
                                <td>@incident.CallerAddress</td>
                            </tr>
                            <tr>
                                <th>Region</th>
                                <td>@incident.Region</td>
                                <th>Received By / Reference</th>
                                <td>@incident.ReferenceNo</td>
                            </tr>
                            <tr>
                                <th>Media</th>
                                <td>@incident.Media</td>
                                <th>Incident Priority</th>
                                <td>@incident.Priority</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section>
                    <h3 class="section-title">Incident Information</h3>

                    <table class="incident-table">
                        <tbody>
                            <tr>
                                <th>What Is Happening</th>
                                <td colspan="3">@incident.IncidentHappenning</td>
                            </tr>
                            <tr>
                                <th>What Has Happened</th>
                                <td colspan="3">@incident.IncidentHappend</td>
                            </tr>
                            <tr>
                                <th>Affected Person</th>
                                <td>@incident.AffectedPerson</td>
                                <th>Relationship with Caller</th>
                                <td>@incident.Relationship</td>
                            </tr>
                            <tr>
                                <th>Incident Address</th>
                                <td>@incident.IncidentAddress</td>
                                <th>Police Station / Reference Point</th>
                                <td>@incident.ReferencePoint</td>
                            </tr>
                            <tr>
                                <th>How Long Ago?</th>
                                <td>@incident.WhenHappened</td>
                                <th>Incident Type</th>
                                <td>
                                    @if (incident.IncidentTypes.Count > 0)
                                    {
                                        <ul>
                                            @foreach (var type in incident.IncidentTypes)
                                            {
                                                <li>@type</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Additional Description</th>
                                <td colspan="3">@incident.AdditionalDescription</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section>
                    <h3 class="section-title">Suspect Information</h3>

                    <table class="incident-table">
                        <tbody>
                            <tr>
                                <th>Suspect Persons</th>
                                <td>@incident.SuspectPersons</td>
                                <th>Accent</th>
                                <td>@incident.Accent</td>
                            </tr>
                            <tr>
                                <th>Weapons Reported</th>
                                <td>@(incident.HaveWeapons ? "Yes" : "No")</td>
                                <th>Physical Appearance</th>
                                <td>@incident.PhysicalAppearance</td>
                            </tr>
                            <tr>
                                <th>Dress Appearance</th>
                                <td>@incident.DressAppearance</td>
                                <th>Leaving Direction</th>
                                <td>@incident.LeavingDirection</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section>
                    <h3 class="section-title">Dispatch Information</h3>

                    <table class="incident-table">
                        <tbody>
                            <tr>
                                <th>Incident Number</th>
                                <td>@incident.IncidentNo</td>
                                <th>Result Code</th>
                                <td>@incident.ResultCode</td>
                            </tr>
                            <tr>
                                <th>Delay Reason</th>
                                <td>@incident.DelayReason</td>
                                <th>Call Dispatch Time</th>
                                <td>@incident.CallDispatchTime</td>
                            </tr>
                            <tr>
                                <th>Units Assigned</th>
                                <td>@incident.UnitsAssigned</td>
                                <th>Officer Assigned</th>
                                <td>@incident.OfficerAssigned</td>
                            </tr>
                            <tr>
                                <th>Unit Informed On</th>
                                <td>@incident.UnitInformedOn</td>
                                <th>Unit Arrived On</th>
                                <td>@incident.UnitArrivedOn</td>
                            </tr>
                            <tr>
                                <th>Resolved Time</th>
                                <td>@incident.ResolvedTime</td>
                                <th>Status</th>
                                <td>
                                    @if (incident.IncidentStatus == 0)
                                    {
                                        <span class="status-label status-open">Open</span>
                                    }
                                    else
                                    {
                                        <span class="status-label status-closed">Closed</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section>
                    <h3 class="section-title">Incident Notes</h3>

                    @if (Model.Notes.Count == 0)
                    {
                        <p class="empty-message">
                            No notes have been recorded for this incident.
                        </p>
                    }
                    else
                    {
                        <table class="incident-table notes-table">
                            <thead>
                                <tr>
                                    <th style="width:20%;">Date and Time</th>
                                    <th style="width:20%;">Recorded By</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in Model.Notes)
                                {
                                    <tr>
                                        <td>
                                            @(note.CaptureDate?.ToString("dd/MM/yyyy HH:mm") ?? "")
                                        </td>
                                        <td>@note.CaptureBy</td>
                                        <td>@note.NoteDescription</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <footer class="document-footer">
                    Royal Eswatini Police Service — Incident Management System
                </footer>

            </main>
        }
    </div>
</body>
</html>
