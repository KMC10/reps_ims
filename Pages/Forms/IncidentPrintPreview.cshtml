
@page "/Forms/IncidentPrintPreview"
@model REPS_IMS.Pages.Forms.IncidentPrintPreviewModel

@{
    Layout = null;
    ViewData["Title"] = "Print Incident";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Incident Report</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.css" />

    <style>
        body {
            background: #fff;
            color: #222;
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 20px;
        }

        .report-header {
            text-align: center;
            border-bottom: 2px solid #333;
            margin-bottom: 18px;
            padding-bottom: 12px;
        }

        .report-header h2 {
            font-size: 20px;
            font-weight: bold;
            margin: 0 0 6px;
        }

        .report-header p {
            margin: 0;
            color: #555;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

        .report-table td {
            border: 1px solid #ccc;
            padding: 7px;
            vertical-align: top;
            overflow-wrap: anywhere;
        }

        .report-table td:first-child {
            width: 28%;
            font-weight: bold;
            background: #f5f5f5;
        }

        .print-actions {
            margin-bottom: 15px;
            text-align: right;
        }

        @@media print {
            body { margin: 0; }
            .print-actions { display: none !important; }
            .report-table td {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="print-actions">
        <button class="btn btn-primary" onclick="window.print()">
            Print / Save as PDF
        </button>
        <button class="btn btn-default" onclick="window.close()">
            Close
        </button>
    </div>

    <div class="report-header">
        <h2>INCIDENT REPORT</h2>
        <p>Royal Eswatini Police Service — Incident Management System</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else
    {
        <table class="report-table">
            <tbody>
                @foreach (var field in Model.Fields)
                {
                    <tr>
                        <td>@field.Key</td>
                        <td style="white-space: pre-wrap;">@field.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</body>
</html>