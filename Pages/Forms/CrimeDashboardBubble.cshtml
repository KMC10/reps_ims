@page "/Forms/CrimeDashboardBubble"
@{ Layout = null; ViewData["Title"] = "CrimeDashboardBubble"; }
<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Crime Dashboard Bubble</title>
    <script src="/bootstrap/js/jquery.min.js"></script>
    <script src="/d3/d3.min.js"></script>

    <style>
        text
        {
            font: 36px sans-serif;
        }

        .circletext
        {
            font: 75px sans-serif;
        }
    </style>
</head>
<body>
    <form method="post">
    </form>
    <script>

        var margin = { top: 10, right: 10, bottom: 10, left: 10 };
        var dataCache;
        var interval;

        function LoadChart() {

            var reqNoCache = new Date().getMilliseconds();

            $.ajax({
                type: "POST",
                url: "/Forms/CrimeDashboardBubbleData?nocache=" + Date.now(),
                data: "{}",
                contentType: "application/json",
                dataType: "json",
                success: function (data) {
                    dataCache = data;
                    DrawChart();
                },
                error: function (xhr) {
                    console.error(
                        "Crime Dashboard Bubble data error:",
                        xhr.status,
                        xhr.responseText
                    );
                }
            });
        }

        function DrawChart() {

            var root = dataCache;

            var height = $(window).height() - margin.top - margin.bottom;
            var width = $(window).width() - margin.left - margin.right;

            var diameter = 500,
                format = d3.format(",d"),
                color = d3.scale.category20c();

            var bubble = d3.layout.pack()
            .sort(null)
            .size([width, height])
            .padding(5)
            .value(function (d) {
                return d.size || 0;
            });


            d3.select("#svgCanvas").remove();

            var svg = d3.select("body").append("svg")
                            .attr("id", "svgCanvas")
                            .attr("width", width)
                            .attr("height", height)
                            .attr("class", "bubble");

            var node = svg.selectAll(".node")
                            .data(bubble.nodes(classes(root))
                            .filter(function (d) { return !d.children; }))
                            .enter().append("g")
                            .attr("class", "node")
                            .attr("transform", function (d) { return "translate(" + d.x + "," + d.y + ")"; });

            node.append("title")
                .text(function (d) { return d.className + ": " + format(d.value); });

            node.append("circle")
                .attr("r", function (d) { return d.r; })
                .style("fill", function (d) { return color(d.packageName); });

            node.append("text")
                .attr("class", "circletext")
                .attr("dy", ".3em")
                .style("text-anchor", "middle")
                .text(function (d) { return d.value; })
                .style("pointer-events", "none");

            // draw legend
            var legend = svg.selectAll(".legend")
                            .data(color.domain())
                            .enter().append("g")
                            .attr("class", "legend")
                            .attr("transform", function (d, i) { return "translate(0," + i * 40 + ")"; });

            // draw legend colored rectangles
            legend.append("rect")
                .attr("x", width - 38)
                .attr("width", 38)
                .attr("height", 38)
                .style("fill", color);

            // draw legend text
            legend.append("text")
                .attr("x", width - 45)
                .attr("y", 15)
                .attr("dy", ".35em")
                .style("text-anchor", "end")
                .text(function (d) { return d; });
        }

        // Returns a flattened hierarchy containing all leaf nodes under the root.
        function classes(root) {
            var classes = [];

            function recurse(name, node) {
                if (node.children) node.children.forEach(function (child) { recurse(node.name, child); });
                else classes.push({ packageName: name, className: node.name, value: node.size });
            }

            recurse(null, root);
            return { children: classes };
        }



        d3.select(self.frameElement).style("height", $(window).height() + "px");

        $(document).ready(function () {
            LoadChart();

            //interval = window.setInterval(function () { LoadChart(); }, 5000);

            $(window).resize(function () {
                DrawChart();
            });
        });

    </script>
</body>
</html>
