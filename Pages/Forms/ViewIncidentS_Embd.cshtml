@page "/Forms/ViewIncidentS_Embd"
@{ Layout = null; ViewData["Title"] = "ViewIncidentS_Embd"; }
<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="//bootstrap/css/bootstrap.css?v0.7" />
    <link rel="stylesheet" href="//bootstrap/css/SiteCSS.css?v0.2" />
    <link rel="stylesheet" href="//bootstrap/css/bootstrap-datetimepicker.css" />

    <script src="//bootstrap/js/jquery.min.js"></script>
    <script src="//bootstrap/js/bootstrap.min.js"></script>
    <script src="//bootstrap/js/moment-with-locales.js"></script>
    <script src="//bootstrap/js/bootstrap-datetimepicker.js"></script>

</head>
<body>
    <form method="post">
        <div class="container-fluid" style="">
            <div class="col-md-12">

                <div class="panel panel-default">
                    <div class="panel-heading">Search Incident</div>
                    <div class="panel-body">

                        <div class="col-md-3">

                            <table style="width: 100%;">
                                <tr>
                                    <td class="LabelColumnSearch">
                                        <label class="control-label input-sm">From Date</label>
                                    </td>
                                    <td class="TableGap">
                                        <input id="txtDateFrom" name="txtDateFrom" type="text" class="form-control" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="LabelColumnSearch">
                                        <label class="control-label input-sm">PIN No.</label>
                                    </td>
                                    <td class="TableGap">
                                        <input id="txtCallerPIN" name="txtCallerPIN" type="text" class="form-control" />
                                    </td>
                                </tr>

                                <tr>
                                    <td class="LabelColumnSearch">
                                        <label class="control-label input-sm">Incident No.</label>
                                    </td>
                                    <td class="TableGap">
                                        <input id="txtIncidentNo" name="txtIncidentNo" type="text" class="form-control" />
                                    </td>
                                </tr>

                                <tr>
                                    <td class="LabelColumnSearch">
                                        <label class="control-label input-sm">Phone No.</label>
                                    </td>
                                    <td class="TableGap">
                                        <input id="txtPhoneNo" name="txtPhoneNo" type="text" class="form-control" />
                                    </td>
                                </tr>


                                <tr>
                                    <td class="LabelColumnSearch">
                                        <label class="control-label input-sm">&nbsp;</label>
                                    </td>
                                    <td class="TableGap" style="text-align: right;">
                                        
                                        
                                    </td>
                                </tr>
                            </table>

                        </div>

                        <div class="col-md-9">

                            <p class="bg-success" runat="server" visible="false" id="lblSussessMessage" style="padding: 10px 0px 10px 5px;">Incident information saved.</p>
                            <p class="bg-danger" runat="server" visible="false" id="lblErrirMessage" style="padding: 10px 0px 10px 5px;">Incident information saved.</p>

                            
                                <Columns>

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    

                                    
                                        <ItemTemplate>
                                            
                                        </ItemTemplate>
                                    
                                    
                                        <ItemTemplate>
                                            <a class="btn btn-primary btn-xs btn-block" href="javascript:return false;" incidentid='<%# DataBinder.Eval(Container.DataItem, "IncidentID") %>' onclick="ShowDetails(this)">View</a>
                                            <a class="btn btn-info btn-xs btn-block" href="javascript:return false;" incidentid='<%# DataBinder.Eval(Container.DataItem, "IncidentID") %>' onclick="ShowNotes(this)">Notes</a>
                                            <a class="btn btn-warning btn-xs btn-block" href="javascript:return false;" incidentid='<%# DataBinder.Eval(Container.DataItem, "IncidentID") %>' onclick="ShowHistory(this)">History</a>
                                            <a class="btn btn-danger btn-xs btn-block" runat="server" id="lnkResolve" href="javascript:return false;" incidentid='<%# DataBinder.Eval(Container.DataItem, "IncidentID") %>' onclick="ResolveIncident(this)">Resolve</a>
                                        </ItemTemplate>
                                    
                                </Columns>
                                <EmptyDataTemplate>
                                    <div class="EmptyRow">No incident information found.</div>
                                </EmptyDataTemplate>
                            
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!--Order Details Modal -->
        <div class="modal fade bs-example-modal-lg" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="width: 100%;">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="myModalLabel">Incident Details</h4>
                    </div>
                    <div class="modal-body" style="height: 500px;">
                        <iframe id="ifDetailsFrame" src="#" style="border: none; width: 100%; height: 100%; padding: 0px;"></iframe>
                    </div>
                </div>
            </div>
        </div>

    </form>

    <script type="text/javascript">

        function ShowDetails(btn) {

            var incidentID = $(btn).attr("incidentID");
            var attender = $("#" + "<%= hfSupervsorID.ClientID %>").val();
            var attenderExt = $("#" + "<%= hfSupervisorExt.ClientID %>").val();

            var $iframe = $('#ifDetailsFrame');
            if ($iframe.length) {
                $iframe.attr('src', 'AddIncident_Embd.aspx?ref=sup&iid=' + incidentID.toString() + '&sid=' + attender + '&ext=' + attenderExt);
            }

            $("#myModalLabel").text("Incident Details");
            $("#myModal").modal("show");
        }

        function ShowNotes(btn) {

            var incidentID = $(btn).attr("incidentID");
            var attender = $("#" + "<%= hfSupervsorID.ClientID %>").val();
            var attenderExt = $("#" + "<%= hfSupervisorExt.ClientID %>").val();

            var $iframe = $('#ifDetailsFrame');
            if ($iframe.length) {
                $iframe.attr('src', 'IncidentNote.aspx?ref=sup&iid=' + incidentID.toString() + '&sid=' + attender + '&ext=' + attenderExt);
            }

            $("#myModalLabel").text("Incident Note");
            $("#myModal").modal("show");
        }

        function ShowHistory(btn) {

            var incidentID = $(btn).attr("incidentID");
            var attender = $("#" + "<%= hfSupervsorID.ClientID %>").val();
            var attenderExt = $("#" + "<%= hfSupervisorExt.ClientID %>").val();

            var $iframe = $('#ifDetailsFrame');
            if ($iframe.length) {
                $iframe.attr('src', 'IncidentHistory.aspx?ref=sup&iid=' + incidentID.toString() + '&sid=' + attender + '&ext=' + attenderExt);
            }

            $("#myModalLabel").text("Incident History");
            $("#myModal").modal("show");
        }

        function ResolveIncident(btn) {

            var reqNoCache = new Date().getMilliseconds();
            var incidentID = $(btn).attr("incidentID");
            var statusSpan = $("#grvIncident span[incidentID='" + incidentID + "']")

            

            $.ajax({
                type: "POST",
                url: "AjaxPage.aspx/ResolveIncident?nocache=" + reqNoCache,
                data: "{'incidentID':" + incidentID + "}",
                contentType: "application/json",
                dataType: "json",
                success: function (data) {
                    if (data.d == 1) {

                        if ($('#<%= ddlStatus.ClientID %>').val() == "-1") {
                            $(btn).hide();
                            statusSpan.text("Resolved");
                        }
                        else {
                            $(btn).parent().parent().fadeOut(800, function () {
                                $(btn).parent().parent().hide();
                            });
                        }
                    }
                    else {
                        alert(data.d);
                    }
                },
                failure: function (response) {
                    alert(response.d);
                }
            });
        }

        $(document).ready(function () {
            $('#<%= txtDateFrom.ClientID %>').datetimepicker({
                format: "DD/MM/YYYY HH:mm"
            });

            $('#<%= txtToDate.ClientID %>').datetimepicker({
                format: "DD/MM/YYYY HH:mm"
            });
        });

        function CloseFrame() {
            $("#myModal").modal("hide");
            return false;
        }

    </script>

    <style type="text/css">
        .modal-lg
        {
            width: 95%;
        }

        .form-control
        {
            padding-bottom: 2px !important;
            padding-top: 2px !important;
            height: 27px !important;
        }
    </style>
</body>
</html>
