@page "/Forms/ViewIncident_Embd"
@{ Layout = null; ViewData["Title"] = "ViewIncident_Embd"; }
<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="//bootstrap/css/bootstrap.css?v0.7" />
    <link rel="stylesheet" href="//bootstrap/css/SiteCSS.css?v0.2" />
    <link rel="stylesheet" href="//bootstrap/css/datepicker.css?v0.1" />

    <script src="//bootstrap/js/jquery.min.js"></script>
    <script src="//bootstrap/js/bootstrap.min.js"></script>
    <script src="//bootstrap/js/bootstrap-datepicker.js?v0.1"></script>
</head>
<body>
    <form method="post">
        <div class="container-fluid" style="">
            <div class="col-md-12">

                <div class="panel panel-default">
                    <div class="panel-heading">View Incident</div>
                    <div class="panel-body">


                        <p class="bg-success" runat="server" visible="false" id="lblSussessMessage" style="padding: 10px 0px 10px 5px;">Incident information saved.</p>
                        <p class="bg-danger" runat="server" visible="false" id="lblErrirMessage" style="padding: 10px 0px 10px 5px;">Incident information saved.</p>

                        
                            <Columns>

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                

                                
                                    <ItemTemplate>
                                        
                                    </ItemTemplate>
                                
                                
                                    <ItemTemplate>
                                        <a class="btn btn-info btn-xs btn-block" href="javascript:return false;" incidentid='<%# DataBinder.Eval(Container.DataItem, "IncidentID") %>' onclick="ShowDetails(this)">View</a>
                                    </ItemTemplate>
                                
                            </Columns>
                            <EmptyDataTemplate>
                                <div class="EmptyRow">No incident information found.</div>
                            </EmptyDataTemplate>
                        

                    </div>
                </div>

            </div>
        </div>

        <!--Order Details Modal -->
        <div class="modal fade bs-example-modal-lg" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="width:100%;">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="myModalLabel">Incident Details</h4>
                    </div>
                    <div class="modal-body" style="height: 500px;">
                        <iframe id="ifDetailsFrame" src="#" style="border: none; width: 100%; height: 100%; padding: 0px;"></iframe>
                    </div>

                </div>
            </div>
        </div>

    </form>

     <script type="text/javascript">

         function ShowDetails(btn) {

             var incidentID = $(btn).attr("incidentID");
             var $iframe = $('#ifDetailsFrame');
             if ($iframe.length) {
                 $iframe.attr('src', 'IncidentDetails.aspx?iid=' + incidentID.toString());
             }
             $("#myModal").modal("show");
         }

    </script>

    <style type="text/css">
        .modal-lg
        {
            width:95%;
        }
    </style>

</body>
</html>
